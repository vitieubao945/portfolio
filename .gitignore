# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress core (managed by Composer, never committed)
web/wp
web/.htaccess

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

# Node / Yarn (frontend deps are theme-scoped; see web/app/themes/sage/.gitignore)
node_modules/
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
.pnp.*

# Editors / OS
.DS_Store
.idea
.vscode

# Docker
docker-compose.override.yml
