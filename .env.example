# Database credentials. Matches the `database` service in docker-compose.yml.
DB_NAME='wordpress'
DB_USER='wordpress'
DB_PASSWORD='password'
DB_HOST='database'
DB_PREFIX='wp_'

# Optionally, you can use a data source name (DSN) instead of the DB_* vars above
# DATABASE_URL='mysql://database_user:database_password@database_host:database_port/database_name'

WP_ENV='development'
WP_HOME='http://localhost:8754'
WP_SITEURL="${WP_HOME}/wp"

# Specify optional debug.log path
# WP_DEBUG_LOG='/path/to/debug.log'

# Generate real values with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;" (run 8x)
# or use the generator at https://roots.io/salts.html
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Vite dev server, used by the `node` service for HMR inside Docker.
# Never put secrets behind a VITE_ prefix: anything with this prefix is
# exposed to browser-side JavaScript by Vite.
VITE_DOCKER='true'
VITE_ORIGIN='http://localhost:5173'
VITE_HMR_HOST='localhost'
